{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis/src/index.ts"],
      "@deepseek-ai/cosmokit": ["../deepseek-harness/vendor/cosmokit/src/index.ts"],
      "@standard-schema/spec": ["node_modules/@standard-schema/spec/dist/index.d.ts"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery/src/index.ts"],
      "@deepseek-ai/dsh-tools": ["../deepseek-harness/packages/core/tools/src/index.ts"],
      "@deepseek-ai/dsh-agent": ["../deepseek-harness/packages/core/agent/src/index.ts"],
      "@deepseek-ai/dsh-session": ["../deepseek-harness/packages/core/session/src/index.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../deepseek-harness/packages/host/webserver/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
