{
  "name": "dsh-chicken-pet",
  "version": "0.1.0",
  "description": "A pixel chicken desktop pet for DeepSeek Harness: it naps, paces, pecks, ruffles its feathers and spins a basketball on its own, and reacts to your agent's work",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pixel-art",
    "chicken"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuzhuang/dsh-chicken-pet.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "scripts": {
    "build": "node scripts/build-sprites.mjs && node scripts/build-plugin.mjs",
    "sprites": "node scripts/build-sprites.mjs",
    "preview": "node scripts/preview-cli.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.20.2",
    "typescript": "^5.6.3"
  }
}
